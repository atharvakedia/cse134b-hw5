---
layout: layouts/base.njk
title: Home
metaTitle: Atharva — Portfolio
description: Personal portfolio homepage for Atharva, a computer science student who builds small, useful web tools end to end.
scripts:
  - /js/quake-feed.js
---
<section id="hero">
  <div>
    <h1>Hi, I&rsquo;m Atharva</h1>
    <p>I&rsquo;m a <b>computer science</b> student who likes building small,
      <em>actually useful</em> web tools end-to-end &mdash; front end, back end,
      and everything in between.</p>
    <p><span class="badge">Open to internships</span></p>
    <p class="actions">
      <a class="button-link" href="/projects/">View Projects</a>
      <a class="button-link" href="/assets/resume-placeholder.pdf">R&eacute;sum&eacute; (PDF)</a>
    </p>
  </div>
  <picture>
    <source srcset="/assets/headshot-placeholder.webp" type="image/webp">
    <img src="/assets/headshot-placeholder.png" alt="Placeholder headshot photo of Atharva" width="200" height="200">
  </picture>
</section>

<section id="featured-projects">
  <h2>Featured Projects</h2>
  <ul class="card-grid">
    {%- for project in collections.projects %}
    <li>
      <article>
        <img src="{{ project.data.image }}" alt="{{ project.data.imageAlt }}" width="320" height="180">
        <h3><a href="{{ project.url }}">{{ project.data.title }}</a></h3>
        <p>{{ project.data.summary }}</p>
      </article>
    </li>
    {%- endfor %}
  </ul>
</section>

<section id="seismic">
  <h2>What the ground is doing</h2>
  <p>A live readout from the U.S. Geological Survey, and the reason this page
    ships any JavaScript at all. Everything else here works without it.</p>

  {#
    Fallback content lives between the tags: if the script is blocked or the
    element never upgrades, this paragraph and link are what the reader gets.
  #}
  <quake-feed magnitude="2.5" period="day" count="5">
    <p>Recent earthquake data is loaded from the U.S. Geological Survey and needs
      JavaScript to display. You can read the same feed directly at
      <a href="https://earthquake.usgs.gov/earthquakes/map/">earthquake.usgs.gov</a>.</p>
  </quake-feed>
</section>
