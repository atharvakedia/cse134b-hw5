{#
  Markup template for a single search result. Authored as a real <template>
  element so the search script clones it rather than assembling an HTML
  string from Pagefind output.
#}
<template id="search-result-template" data-pagefind-ignore>
  <li>
    <h3><a></a></h3>
    <p class="search-excerpt"></p>
  </li>
</template>
